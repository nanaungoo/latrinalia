{
  "name": "latrinalia",
  "version": "1.0.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "description": "Digital toilet graffiti wall — a PWA for anonymous stall-side scribbling",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node server/index.js",
    "client": "vite --port 3000",
    "build": "vite build",
    "start": "node server/index.js",
    "preview": "vite preview",
    "db:init": "node scripts/db-init.js",
    "db:reset": "node scripts/db-init.js",
    "cf:dev": "wrangler dev",
    "cf:deploy": "wrangler deploy",
    "cf:pages": "wrangler pages deploy dist",
    "cf:d1:init": "wrangler d1 create latrinalia-db",
    "cf:d1:migrate": "wrangler d1 execute latrinalia-db --file=supabase/migrations/001_create_tables.sql && wrangler d1 execute latrinalia-db --file=supabase/migrations/002_seed_stickers.sql && wrangler d1 execute latrinalia-db --file=supabase/migrations/003_rate_limits.sql"
  },
  "dependencies": {
    "hono": "^4.12.32",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-draggable": "^4.4.6"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "vite": "^5.4.0",
    "wrangler": "^4.110.0"
  }
}
